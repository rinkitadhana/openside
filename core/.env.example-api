DATABASE_URL="postgresql://postgres:password@localhost:5432/my_database"
REDIS_URL="redis://localhost:6379"

WEB_URL="http://localhost:3000"
PORT="4000"
NODE_ENV="production"

WORKER_WAKE_URL="http://worker.railway.internal:4000"
WORKER_WAKE_SECRET="replace-with-the-same-long-random-secret-as-the-worker"

# Keep false for a single serverless API. Redis-backed rate limits require a
# permanent Redis connection and are intended for multi-replica always-on APIs.
RATE_LIMIT_REDIS="false"
# Close BullMQ producer connections after this much inactivity.
QUEUE_PRODUCER_IDLE_MS="30000"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_AUTHORIZED_PARTIES="http://localhost:3000"

LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_TOKEN_TTL_SECONDS="21600"
LIVEKIT_ROOM_API_TIMEOUT_MS="8000"
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS="600"
LIVEKIT_ROOM_MAX_PARTICIPANTS="50"

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET="openside-recordings"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="Openside <you@gmail.com>"

POLAR_ACCESS_TOKEN="polar_oat_xxx"
POLAR_WEBHOOK_SECRET="whsec_xxx"
POLAR_PRO_PRODUCT_ID="your-pro-product-uuid"
POLAR_SERVER="sandbox"

SELFHOST_ENCRYPTION_KEY="replace-with-32-byte-hex-or-base64-key"
